SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY
TURNSTILE_SITE_KEY=YOUR_PUBLIC_SITE_KEY
# Comma-separated exact frontend origins; same-origin works without this.
ALLOWED_ORIGINS=

# Optional: private organizer email command (npm run email).
# Supabase verification/reset SMTP credentials go in its dashboard, NOT here.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=DataJam 2026
BREVO_REPLY_TO=
